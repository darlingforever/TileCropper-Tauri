{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TileCropper 默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-file",
